APP_NAME=StatusConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8070

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=statusconnect
DB_USERNAME=statusconnect
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@statusconnect.local"
MAIL_FROM_NAME="${APP_NAME}"

TARGET_URL=http://target:8080

CHECK_CONCURRENCY=10
CHECK_TARGET_DURATION_SECONDS=45
CHECK_CLAIM_TTL_MINUTES=5
CHECK_WAVE_SIZE=10
CHECK_MAX_TIMEOUT_MS=30000
FLAP_THRESHOLD=5
FLAP_WINDOW_MINUTES=60

GRANDPASSON_OUTBOUND_ENABLED=false
GRANDPASSON_INBOUND_ENABLED=false
GRANDPASSON_BASE_URL=http://host.docker.internal:8080

APP_PORT=8070
MYSQL_PORT=3308
MAILPIT_UI_PORT=8035
MAILPIT_SMTP_PORT=1035
TARGET_PORT=8095
VITE_PORT=5173
